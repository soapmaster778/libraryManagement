{
  "name": "library-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --port 9000",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "tsx node_modules/mocha/bin/mocha.js \"tests/**/*.test.ts\"",
    "prepare": "husky",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "dev": "vite --port 9000",
    "preview": "vite preview"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/bootstrap": "^5.2.11",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "chai": "^5.3.3",
    "eslint": "^9.36.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "mocha": "^11.7.2",
    "prettier": "^3.9.5",
    "sass": "^1.92.1",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^8.3.0"
  }
}
